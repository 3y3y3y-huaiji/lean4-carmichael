/-
  【初等数论经典命题：数学归纳法证明整除性】

  大白话题意：
  证明：对于任意自然数 n（0, 1, 2, 3...），式子 3^(2n+1) + 2^(n+2) 永远能被 7 整除。

  数学表达：
  ∀ n : Nat, 7 ∣ 3^(2*n + 1) + 2^(n + 2)
-/

/-- 核心定理：7 能整除 3^(2*n + 1) + 2^(n + 2) -/
theorem div_by_seven (n : Nat) : 7 ∣ 3^(2 * n + 1) + 2^(n + 2) := by
  -- 第一步：对自然数 n 进行数学归纳法
  induction n with
  -- 基础步：n = 0
  | zero =>
    -- 计算：3^(2*0+1) + 2^(0+2) = 3 + 4 = 7，7 显然能被 7 整除
    decide

  -- 归纳步：假设当 n = k 时命题成立（记为 ih），推导 n = k + 1 也成立
  | succ k ih =>
    -- 展开归纳假设：存在某个自然数 m，使得 3^(2k+1) + 2^(k+2) = 7 * m
    match ih with
    | ⟨m, hm⟩ =>
      -- 幂次化简引理 1：3^(2(k+1)+1) = 9 * 3^(2k+1)
      have h1 : 3^(2 * (k + 1) + 1) = 9 * 3^(2 * k + 1) := by
        have : 2 * (k + 1) + 1 = (2 * k + 1) + 2 := by omega
        rw [this, Nat.pow_add]
        omega

      -- 幂次化简引理 2：2^((k+1)+2) = 2 * 2^(k+2)
      have h2 : 2^(k + 1 + 2) = 2 * 2^(k + 2) := by
        have : k + 1 + 2 = (k + 2) + 1 := by omega
        rw [this, Nat.pow_succ]
        omega

      -- 将化简结果代入待证目标式
      rw [h1, h2]

      -- 配凑逻辑：
      -- 9 * A + 2 * B = 7 * A + 2 * (A + B) = 7 * A + 2 * (7 * m) = 7 * (A + 2 * m)
      -- 给出商为 (3^(2*k+1) + 2 * m)
      refine ⟨3^(2 * k + 1) + 2 * m, ?_⟩

      -- 由线性代数与整除自动化策略 omega 瞬间完成等式验证并闭合证明
      omega

-- ==========================================
-- 实际计算效果演示（测试具体数值）
-- ==========================================

def f (n : Nat) : Nat := 3^(2 * n + 1) + 2^(n + 2)

#eval f 0   -- 输出 7，    7 / 7 = 1，余 0
#eval f 1   -- 输出 35，   35 / 7 = 5，余 0
#eval f 2   -- 输出 259，  259 / 7 = 37，余 0
#eval f 3   -- 输出 2219， 2219 / 7 = 317，余 0
